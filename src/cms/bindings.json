  {
    "section": "about",
    "route": "/about-us",
    "file": "about-us/index.html",
    "key": "copy.item1",
    "selector": ".entry-content p,.entry-content .elementor-widget-text-editor > .elementor-widget-container,.entry-content .elementor-accordion-title",
    "index": 1,
    "type": "text",
    "original": "HYS Flanges Co. Ltd specializes in producing flanges and fittings for all types of applications. Our products serve a wide range of industries, including oil and gas pipelines, oil refineries, power generation, construction, shipbuilding and offshore engineering, boilers and heat exchangers, machinery, sanitary systems, instrumentation, chemical and petrochemical plants, palm oil processing, biodiesel production, and more."
  },
  {
    "section": "about",
    "route": "/about-us",
    "file": "about-us/index.html",
    "key": "copy.item2",
    "selector": ".entry-content p,.entry-content .elementor-widget-text-editor > .elementor-widget-container,.entry-content .elementor-accordion-title",
    "index": 3,
    "type": "text",
    "original": "At HYS Flanges Co. Ltd, our corporate values and commitment to high-quality service, flanges, and fittings guide every business strategy and goal. We continually improve our services and expand our product range to serve our customers more effectively."
  },
  {
    "section": "about",
    "route": "/about-us",
    "file": "about-us/index.html",
    "key": "copy.item3",
    "selector": ".entry-content p,.entry-content .elementor-widget-text-editor > .elementor-widget-container,.entry-content .elementor-accordion-title",
    "index": 4,
    "type": "text",
    "original": "\u2022 Maintain ready stock of flanges and fittings to support customers and expand our market reach.\n\u2022 Broaden our product range to meet customer requirements and support long-term business growth.\n\u2022 Provide dependable, ongoing support to every customer.\n\u2022 Deliver excellent after-sales service through our experienced sales team."
  },
  {
    "section": "about",
    "route": "/about-us",
    "file": "about-us/index.html",
    "key": "copy.item4",
    "selector": ".entry-content p,.entry-content .elementor-widget-text-editor > .elementor-widget-container,.entry-content .elementor-accordion-title",
    "index": 5,
    "type": "text",
    "original": "HYS Flanges Co. Ltd manufactures high-quality flanges for oil and gas, refining, power generation, shipbuilding, offshore engineering, chemical processing, and other industrial applications. Our flanges are engineered for reliable connections, long service life, and performance across low- and high-pressure systems."
  },
  {
    "section": "about",
    "route": "/about-us",
    "file": "about-us/index.html",
    "key": "copy.item5",
    "selector": ".entry-content p,.entry-content .elementor-widget-text-editor > .elementor-widget-container,.entry-content .elementor-accordion-title",
    "index": 6,
    "type": "text",
    "original": "Mill test certification is available upon request."
  },
  {
    "section": "about",
    "route": "/about-us",
    "file": "about-us/index.html",
    "key": "copy.item6",
    "selector": ".entry-content p,.entry-content .elementor-widget-text-editor > .elementor-widget-container,.entry-content .elementor-accordion-title",
    "index": 7,
    "type": "text",
    "original": "HYS Flanges Co. Ltd produces forged fittings for industrial piping systems, including threaded and socket-weld configurations. Our fittings are manufactured to recognized standards and supplied in a range of sizes and pressure classes to meet project requirements."
  },
